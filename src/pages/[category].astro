---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

// 分类页统一路由：/tech、/life 共用本页（结构规则：禁止孪生页面）
export async function getStaticPaths() {
  const categories = [
    { slug: 'tech', name: '技术' },
    { slug: 'life', name: '生活' },
  ];
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { name: cat.name },
  }));
}

const { name } = Astro.props;
const sortedPosts = (await getPublishedPosts()).filter(
  (post) => post.data.category === name
);
---

<BaseLayout title={name}>
  <div class="category-page">
    <div class="category-header">
      <h1>{name}</h1>
    </div>
    <p class="category-info">共 {sortedPosts.length} 篇文章 ♪</p>
    <div class="post-list">
      {sortedPosts.map((post) => (
        <div class="post-item">
          <PostCard
            title={post.data.title}
            slug={post.slug}
            date={post.data.date}
            description={post.data.description}
            tags={post.data.tags}
            category={post.data.category}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 720px;
    margin: 0 auto;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
  }

  .category-header h1 {
    font-size: 1.6rem;
    color: var(--text-primary);
  }

  .category-info {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 1.8rem;
    letter-spacing: 0.04em;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
