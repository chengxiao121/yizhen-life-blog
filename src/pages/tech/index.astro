---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.category === "技术");
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="技术">
  <div class="category-page">
    <div class="category-header">
      <h1>技术</h1>
    </div>
    <p class="category-info">共 {sortedPosts.length} 篇文章 ♪</p>
    <div class="post-list">
      {sortedPosts.map((post, index) => (
        <div class:list={["post-item", `post-item-${(index % 3) + 1}`]}>
          <PostCard
            title={post.data.title}
            slug={post.slug}
            date={post.data.date}
            description={post.data.description}
            tags={post.data.tags}
            category={post.data.category}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 720px;
    margin: 0 auto;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
  }

  .category-header h1 {
    font-size: 1.6rem;
    color: #ffffff;
  }

  .category-info {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 1.8rem;
    letter-spacing: 0.04em;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-item-1 { transform: rotate(-0.8deg); }
  .post-item-2 { transform: rotate(0.5deg); }
  .post-item-3 { transform: rotate(-0.3deg); }

  .post-item {
    transition: transform 0.2s ease;
  }

  .post-item:hover {
    transform: rotate(0deg) !important;
  }
</style>
