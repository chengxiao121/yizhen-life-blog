---
// 欢迎页 — 站点首页（由 BaseLayout 瘦骨架生成：导航行 + 主内容）
// 站名 + 副标语 + welcome 文字变图片交互（移植自 boknows-text-image-template）。
// 备案号按决策仅首页展示（一行极简）。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="落羽闲笺 — 世界那么大，我先溜达溜达" description="世界喧嚣，思绪缓缓停泊。">
  <section class="landing">
    <h1 class="site-name">落羽闲笺</h1>
    <p class="tagline">欢迎来到我的空间</p>
    <div class="hero-words">
      <span id="words" class="words" role="img" aria-label="welcome"></span>
    </div>
    <p id="status" class="hint" role="status">正在准备字母图片…</p>
  </section>

  <p class="icp-line">
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2026156601号-1</a>
  </p>
</BaseLayout>

<style is:global>
  /* 首页专属布局。保留 is:global 是因为字母/贴纸元素由脚本动态创建，scoped 样式作用不到；
     这些样式只随首页加载，视图过渡换页时自动移除，不影响博客页。 */
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    max-width: none;
    margin: 0;
    padding: 0 7vw;
  }

  /* landing：单列左对齐，右侧暂留白（后续有想法再扩展） */
  .landing {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .icp-line {
    padding: 1.2rem 0;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .icp-line a {
    color: var(--text-muted);
  }

  .icp-line a:hover {
    color: var(--accent-hover);
  }

  /* ---- 左侧文字区 ---- */
  .site-name {
    font-size: clamp(44px, 5.5vw, 88px);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--accent-hover);
    text-shadow: 3px 3px 0 rgba(245, 184, 196, 0.6);
  }

  .tagline {
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.14em;
    margin: 1rem 0 3.2rem;
  }

  /* ---- welcome 交互文字（移植自模板） ---- */
  .hero-words {
    font-size: clamp(54px, 7vw, 116px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .words {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 1.34em;
    touch-action: pan-y pinch-zoom;
  }

  .word { display: inline-flex; flex-shrink: 0; }

  .letter {
    pointer-events: none;
    display: inline-grid;
    position: relative;
    align-items: center;
    height: 1.08em;
    flex-shrink: 0;
    transition: padding-inline 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .char { grid-area: 1 / 1; line-height: 1; justify-self: center; }

  .letter.active .char,
  .letter.pending .char { visibility: hidden; }

  .letter.returning .char {
    animation: letter-soft-return 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes letter-soft-return {
    0%, 20% { opacity: 0; transform: scale(0.88); }
    65% { opacity: 1; transform: scale(1.035); }
    100% { opacity: 1; transform: scale(1); }
  }

  .sticker {
    position: absolute;
    top: calc(50% + var(--offset, 0em));
    left: 50%;
    translate: -50% -50%;
    z-index: 1;
    pointer-events: none;
  }

  .sticker img {
    display: block;
    height: var(--height, 1.12em);
    width: auto;
    max-width: var(--maxwidth, 1.377em);
    object-fit: contain;
  }

  .hit-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    color: transparent;
    user-select: none;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .hit {
    display: inline-flex;
    align-items: center;
    pointer-events: auto;
    height: 1.35em;
    line-height: 1;
  }

  .hint {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 860px) {
    main { padding: 0 8vw; }
    .landing { padding: 4rem 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter, .hit { transition: none; }
    .letter.returning .char { animation: none; }
  }
</style>

<script>
  import { onPageLoad } from '../lib/on-page-load';

  // 模块脚本一次会话只执行一次；视图过渡下每次导航都会触发 astro:page-load，
  // 而字母交互的全部状态都随 DOM 换新，必须在这里整体重建。
  // （导航点击的延迟跳转已下沉到 GooeyNav 组件内部，全站统一生效）
  onPageLoad(() => {
    // 非欢迎页（博客各页导航时也会触发本事件）直接跳过
    const words = document.querySelector('#words');
    const status = document.querySelector('#status');
    if (!words || !status) return;
    let disposed = false;

    // —— 文字变图片交互，移植自 boknows-text-image-template（MIT） ——
    const CONFIG = {
      text: 'welcome',
      imagesByPosition: [
        ['/landing/00-w-a.webp', '/landing/00-w-b.webp'],
        ['/landing/01-e-a.webp', '/landing/01-e-b.webp'],
        ['/landing/02-l-a.webp', '/landing/02-l-b.webp'],
        ['/landing/03-c-a.webp', '/landing/03-c-b.webp'],
        ['/landing/04-o-a.webp', '/landing/04-o-b.webp'],
        ['/landing/05-m-a.webp', '/landing/05-m-b.webp'],
        ['/landing/06-e-a.webp', '/landing/06-e-b.webp']
      ],
      enterDuration: 340,
      exitDuration: 620
    };

    if (CONFIG.exitDuration) {
      document.documentElement.style.setProperty('--exit-duration', CONFIG.exitDuration + 'ms');
    }

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const tokens = Array.from(CONFIG.text);
    const states = [];
    let introTimers = [], autoTimer, hovered = null, inside = false, paused = false, ready = false, inIntro = false, lastAuto = -1, activeQueue = [], visible = true;

    for (let index = 0; index < tokens.length; index++) {
      const ch = tokens[index];
      const el = document.createElement('span');
      el.className = 'letter';
      const char = document.createElement('span');
      char.className = 'char';
      char.textContent = ch;
      el.append(char);
      words.append(el);

      const hit = document.createElement('span');
      hit.className = 'hit';
      hit.dataset.index = index;
      hit.textContent = ch;

      states.push({ el, char, hit, ch, index, loaded: [], last: null, timer: null, active: false });
    }

    const hitLayer = document.createElement('span');
    hitLayer.className = 'hit-layer';
    states.forEach(s => hitLayer.append(s.hit));
    words.append(hitLayer);

    function hide(s) {
      clearTimeout(s.timer);
      const sticker = s.el.querySelector('.sticker');
      const wasActive = s.active;
      s.active = false;
      s.el.classList.remove('active', 'pending');
      if (wasActive) {
        s.el.classList.remove('returning');
        void s.el.offsetWidth;
        s.el.classList.add('returning');
        if (sticker && !reduced.matches) {
          const pose = getComputedStyle(sticker).transform;
          sticker.getAnimations().forEach(a => a.cancel());
          const exit = sticker.animate([
            { transform: pose, opacity: 1, offset: 0 },
            { transform: `${pose} scale(1.055)`, opacity: 1, offset: 0.2 },
            { transform: `${pose} scale(0.7)`, opacity: 0.42, offset: 0.62 },
            { transform: `${pose} scale(0.35)`, opacity: 0, offset: 1 }
          ], { duration: CONFIG.exitDuration || 620, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' });
          exit.onfinish = () => sticker.remove();
        } else sticker?.remove();
      }
      s.el.style.paddingInline = '0em';
      s.hit.style.paddingInline = '0em';
    }

    function clearIntro() {
      introTimers.forEach(clearTimeout);
      introTimers = [];
      inIntro = false;
      states.forEach(s => { s.el.classList.remove('pending'); hide(s); });
    }

    function returnLater(s, ms) {
      clearTimeout(s.timer);
      s.timer = setTimeout(() => { if (hovered !== s.index) hide(s); }, ms);
    }

    function springFrames(angle, y) {
      return Array.from({ length: 41 }, (_, i) => {
        const t = i / 40;
        const value = i === 40 ? 1 : 1 - Math.exp(-7.2 * t) * (Math.cos(10.5 * t) + 0.24 * Math.sin(10.5 * t));
        return { offset: t, transform: `translateY(${y + 8 * (1 - value)}px) rotate(${angle - 8 * (1 - value)}deg) scale(${0.35 + 0.65 * value})` };
      });
    }

    function show(s, { intro = false, automatic = false } = {}) {
      if (reduced.matches || !s.loaded.length) return;
      if (!intro && inIntro) clearIntro();
      clearTimeout(s.timer);

      const pool = s.loaded.filter(a => a !== s.last);
      const items = pool.length ? pool : s.loaded;
      const src = items[Math.floor(Math.random() * items.length)];
      s.last = src;
      s.active = true;
      s.el.classList.remove('pending', 'returning');
      s.el.classList.add('active');
      s.el.querySelector('.sticker')?.remove();

      const sticker = document.createElement('span');
      sticker.className = 'sticker';
      const image = document.createElement('img');
      image.src = src;
      image.alt = '';
      image.draggable = false;
      sticker.append(image);
      s.el.append(sticker);

      s.el.style.setProperty('--height', ['o', 'w'].includes(s.ch) ? '1.18em' : '1.08em');
      s.el.style.setProperty('--maxwidth', '1.377em');
      s.el.style.setProperty('--offset', '0em');

      const fontSize = parseFloat(getComputedStyle(words).fontSize);
      const baseWidth = states.reduce((sum, item) => sum + item.char.getBoundingClientRect().width, 0);
      const openingLimit = Math.max(0, (words.clientWidth - baseWidth - 24) / (2 * states.length * fontSize));

      const imageWidth = s.imageWidths?.get(src) || 1.08;
      const glyphWidth = s.char.getBoundingClientRect().width / fontSize;
      const expandedPadding = Math.min(0.18, Math.max(0.10, (imageWidth - glyphWidth) * 0.22));
      const padding = intro ? Math.min(expandedPadding, openingLimit) : expandedPadding;
      s.el.style.paddingInline = s.hit.style.paddingInline = `${padding}em`;

      const angle = [-9, 7, -5, 8, -7, 6, -4][s.index % 7];
      const y = [3, -2, 2, -3, 1, 3, -1][s.index % 7];
      sticker.animate(springFrames(angle, y), { duration: CONFIG.enterDuration || 340, fill: 'both' });

      activeQueue = activeQueue.filter(i => i !== s.index);
      activeQueue.push(s.index);
      if (!intro) while (activeQueue.length > 4) hide(states[activeQueue.shift()]);

      if (!intro && hovered !== s.index) returnLater(s, automatic ? 1000 : 420);
    }

    function introDuration() {
      return 85 * Math.max(0, states.filter(s => s.loaded.length).length - 1) + 660;
    }

    function schedule(first = false) {
      clearTimeout(autoTimer);
      if (!ready || paused || inside || document.hidden || !visible || reduced.matches) return;
      autoTimer = setTimeout(() => {
        let available = states.filter(s => s.loaded.length && s.index !== lastAuto);
        if (!available.length) available = states.filter(s => s.loaded.length);
        if (!available.length) return;
        const s = available[Math.floor(Math.random() * available.length)];
        lastAuto = s.index;
        show(s, { automatic: true });
        schedule();
      }, first ? introDuration() + 1000 + 1000 * Math.random() : 1300 + 1500 * Math.random());
    }

    function start() {
      clearTimeout(autoTimer);
      clearIntro();
      activeQueue = [];
      if (reduced.matches) { status.textContent = '已遵循系统的减少动态效果设置'; return; }
      inIntro = true;
      const items = states.filter(s => s.loaded.length);
      items.forEach(s => s.el.classList.add('pending'));
      items.forEach((s, i) => introTimers.push(setTimeout(() => show(s, { intro: true }), i * 40)));
      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      shuffled.forEach((s, i) => introTimers.push(setTimeout(() => hide(s), 40 * Math.max(0, items.length - 1) + 660 + 45 * i)));
      introTimers.push(setTimeout(() => {
        inIntro = false;
        status.textContent = '将鼠标移到字母上，看看它会变成什么';
      }, introDuration()));
      schedule(true);
    }

    function point(event) {
      inside = true;
      clearTimeout(autoTimer);
      const hit = document.elementFromPoint(event.clientX, event.clientY)?.closest('[data-index]');
      const next = hit && words.contains(hit) ? Number(hit.dataset.index) : null;
      if (next === hovered) return;
      const old = hovered;
      hovered = next;
      if (old !== null && states[old].active) hide(states[old]);
      if (next !== null) show(states[next]);
    }

    words.addEventListener('pointerenter', () => { inside = true; clearTimeout(autoTimer); });
    words.addEventListener('pointermove', point);
    words.addEventListener('pointerdown', point);

    function leave() {
      inside = false;
      const old = hovered;
      hovered = null;
      if (old !== null && states[old].active) hide(states[old]);
      schedule(true);
    }
    words.addEventListener('pointerleave', leave);
    words.addEventListener('pointercancel', leave);
    words.addEventListener('pointerup', e => { if (e.pointerType !== 'mouse') leave(); });

    const onVisibility = () => {
      if (document.hidden) { clearTimeout(autoTimer); if (inIntro) clearIntro(); }
      else schedule(true);
    };
    document.addEventListener('visibilitychange', onVisibility);

    const io = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      schedule(true);
    }, { threshold: 0.25 });
    io.observe(words);

    const onReducedChange = () => {
      if (reduced.matches) { clearIntro(); clearTimeout(autoTimer); }
      else if (ready) start();
    };
    reduced.addEventListener('change', onReducedChange);

    async function load(s, src) {
      const im = new Image();
      im.src = src;
      try {
        await im.decode();
        s.loaded.push(src);
        s.imageWidths ??= new Map();
        s.imageWidths.set(src, Math.min(('ow'.includes(s.ch) ? 1.18 : 1.08) * im.naturalWidth / im.naturalHeight, 1.377));
        let width = Math.min(1.32 * im.naturalWidth / im.naturalHeight, 1.62);
        try {
          const canvas = document.createElement('canvas');
          const scale = Math.min(1, 160 / Math.max(im.naturalWidth, im.naturalHeight));
          canvas.width = Math.max(1, Math.round(im.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(im.naturalHeight * scale));
          const ctx = canvas.getContext('2d', { willReadFrequently: true });
          ctx.drawImage(im, 0, 0, canvas.width, canvas.height);
          const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
          let left = canvas.width, right = -1;
          for (let y = 0; y < canvas.height; y++) {
            for (let x = 0; x < canvas.width; x++) {
              if (data[(y * canvas.width + x) * 4 + 3] > 8) {
                left = Math.min(left, x);
                right = Math.max(right, x);
              }
            }
          }
          if (right >= left) width = (right - left + 1) / scale * Math.min(1.32 / im.naturalHeight, 1.62 / im.naturalWidth);
        } catch {}
        s.padding = s.padding ?? new Map();
        s.padding.set(src, Math.max(0.12, (width / 1.62) * 0.28) * 0.85 * 0.85);
      } catch {}
    }

    Promise.all(states.flatMap((s, i) => CONFIG.imagesByPosition[i].map(src => load(s, src)))).then(() => {
      if (disposed) return;
      states.forEach((s, i) => s.loaded.sort((a, b) => CONFIG.imagesByPosition[i].indexOf(a) - CONFIG.imagesByPosition[i].indexOf(b)));
      ready = true;
      start();
    });

    // 离开页面时停掉全部定时器与 document 级监听；
    // 绑在 words 等被换掉 DOM 上的监听随旧元素一起回收，无需处理
    return () => {
      disposed = true;
      clearIntro();
      clearTimeout(autoTimer);
      document.removeEventListener('visibilitychange', onVisibility);
      reduced.removeEventListener('change', onReducedChange);
      io.disconnect();
    };
  });
</script>
