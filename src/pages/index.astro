---
// 欢迎页 — 站点首页（由 BaseLayout 瘦骨架生成：导航行 + 主内容）
// 站名 + 副标语 + welcome 文字变图片交互（移植自 boknows-text-image-template）。
// 右侧人物视频：加载后暂停，鼠标横向相对位移擦洗时间轴（头部随鼠标转向）。
// 樱花氛围层：Canvas 粒子全屏飘落，浮于内容之前，不拦截任何交互（见脚本 SAKURA 段）。
// 备案号按决策仅首页展示（一行极简）。
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthText from '../components/react/DepthText';
---

<BaseLayout title="落羽闲笺 — 世界那么大，我先溜达溜达" description="世界喧嚣，思绪缓缓停泊。">
  <canvas id="sakura-canvas" aria-hidden="true"></canvas>
  <section class="landing">
    <div class="landing-text">
      <!-- 站名立体字：React 岛屿（SSR 先渲染出面层文字，hydration 后厚度抽出）。
           可读性关键在字面/墙体色相明度分离：橙字面 + 赤陶深橙墙体（--accent-deep，
           同色相压暗，像字的背光面）。已否决：粉墙与暖橙同明度会黏连；墨棕太重；
           灰紫米白底上发闷；白墙沉进米白背景立体感消失。tilt 8 / depth 2.2 / 0.16em 字距
           跟踪区（margin 为超出元素边缘的倍数）：横向总宽 2 倍字宽、纵向即字高本身 -->
      <h1 class="site-name">
        <DepthText
          client:load
          text="落羽闲笺"
          layers={28}
          depth={2.2}
          faceColor="var(--accent-hover)"
          depthColor="var(--accent-deep)"
          tilt={8}
          trackMarginX={0.5}
          trackMarginY={0}
          hoverPush={0.5}
          shadow={false}
          fontSize="clamp(44px, 5.5vw, 88px)"
          fontWeight={900}
          className="depth-text--cjk"
        />
      </h1>
      <p class="tagline">欢迎来到我的灵质空间</p>
      <p class="sub-line">写作、摄影、音乐、打球、也持续创作产品与项目。</p>
      <p class="sub-line">在AI时代，用理性驱动理想，用灵性创造生纪</p>
      <div class="hero-words">
        <span id="words" class="words font-loading" role="img" aria-label="Calm wraps fleeting moments"></span>
      </div>
      <p id="status" class="hint" role="status">正在准备字母图片…</p>
    </div>
    <div class="hero-media" aria-hidden="true">
      <!-- 不写 src/preload：视频 3.9MB，由脚本判定设备可交互后才按需注入；
           触屏与减动效用户只消费 poster（与正面帧同画面），零视频流量 -->
      <video
        id="hero-video"
        poster="/landing/hero-character-poster.jpg"
        muted
        playsinline
        disablepictureinpicture
      ></video>
    </div>
  </section>

  <p class="icp-line">
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2026156601号-1</a>
  </p>
</BaseLayout>

<style is:global>
  /* 首页专属布局。保留 is:global 是因为字母/贴纸元素由脚本动态创建，scoped 样式作用不到；
     这些样式只随首页加载，视图过渡换页时自动移除，不影响博客页。 */
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    max-width: none;
    margin: 0;
    padding: 0 7vw;
  }

  /* landing：左文字 + 右侧人物视频层（方案 A）。
     负 margin 抵消 main 内边距实现通栏，视频层直达视口右缘；
     左缘用蒙版渐变融入米白页面背景；文字区在上层不受影响。 */
  .landing {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 -7vw;
    padding: 0 7vw;
  }

  .landing-text {
    position: relative;
    z-index: 1;
  }

  .hero-media {
    /* fixed 而非 absolute：铺满整个视口高，视频矩形的上/右/下三条边全部
       推出屏幕外，只保留左缘蒙版这一条渐变过渡；z-index:-1 垫底不挡内容 */
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62vw;
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 26%);
    mask-image: linear-gradient(to right, transparent 0%, black 26%);
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
    display: block;
  }

  /* ---- 樱花氛围层 ----
     fixed 全屏铺满视口；浮于所有内容之前（内容最高 z-index 为 3），
     pointer-events:none 保证永不拦截视频擦洗 / 字母交互 / 链接点击。
     花瓣整体透明度在脚本 CONFIG.opacity 控制，这里只管层级与尺寸 */
  #sakura-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 20;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #sakura-canvas { display: none; }
  }

  .icp-line {
    padding: 1.2rem 0;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .icp-line a {
    color: var(--text-muted);
  }

  .icp-line a:hover {
    color: var(--accent-hover);
  }

  /* ---- 左侧文字区 ---- */
  /* 站名视觉已整体移交 DepthText 岛屿（颜色/字号/字距均在组件 props 与其 CSS 内），
     这里不再保留任何站名样式，h1 仅作语义容器与默认文档流间距 */

  .tagline {
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.14em;
    margin: 1rem 0 0.8rem;
  }

  .sub-line {
    font-size: clamp(13px, 1.1vw, 16px);
    color: var(--text-secondary);
    letter-spacing: 0.06em;
    margin: 0.35rem 0;
  }

  /* ---- welcome 交互文字（移植自模板） ---- */
  .hero-words {
    margin-top: 3.2rem;
    /* 整行左移约 1 个字母宽（em 随字号等比缩放）；想移更多改大负值，两个字母 ≈ -1.2em */
    margin-left: -0.4em;
    /* 两行排版：最长行 "fleeting moments" 约 8em 宽，字号上限可比单行时提升约 50% */
    font-size: clamp(34px, 6.2vw, 112px);
    font-family: var(--font-display-en);
    /* Cormorant 引入的是 italic 字面，需显式斜体；700 为该字体可用的最重字重 */
    font-style: italic;
    font-weight: 700;
    line-height: 0.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .words {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.025em;
    align-items: center;
    min-height: 1.34em;
    touch-action: pan-y pinch-zoom;
  }

  /* 字体加载期隐藏：等 Cormorant 就绪 + 动态居中完成后再显示，
     避免兜底字体/未居中位置闪现（脚本移除该类，JS 失效时最多由 2s 兜底恢复） */
  .words.font-loading { visibility: hidden; }

  .word { display: inline-flex; flex-shrink: 0; }

  .letter-space { width: 0.32em; }

  /* 强制换行位（空格处撑满整行，把后续字母挤到下一行）；
     高度必须归零，否则这个隐形元素自己占一整行字母的高度，两行之间会出现大空隙 */
  .letter-break { flex-basis: 100%; width: auto; }
  .letter.letter-break,
  .hit.letter-break { height: 0; }

  .letter {
    pointer-events: none;
    display: inline-grid;
    position: relative;
    align-items: center;
    height: 1em;
    flex-shrink: 0;
    transition: padding-inline 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .char { grid-area: 1 / 1; line-height: 1; justify-self: center; }

  .letter.active .char,
  .letter.pending .char { visibility: hidden; }

  /* 字母返回动画已改为 WAAPI（见脚本 RETURN_FRAMES），不再用 CSS 类 + @keyframes */

  .sticker {
    position: absolute;
    top: calc(50% + var(--offset, 0em));
    left: 50%;
    translate: -50% -50%;
    z-index: 1;
    pointer-events: none;
  }

  .sticker img {
    display: block;
    height: var(--height, 1.12em);
    width: auto;
    max-width: var(--maxwidth, 1.377em);
    object-fit: contain;
  }

  .hit-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    color: transparent;
    user-select: none;
    pointer-events: none;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.025em;
    align-items: center;
  }

  .hit {
    display: inline-flex;
    align-items: center;
    pointer-events: auto;
    height: 1.25em;
    line-height: 1;
  }

  .hint {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 860px) {
    main { padding: 0 8vw; }
    .landing { padding: 4rem 8vw 1rem; margin: 0 -8vw; gap: 2rem; }
    /* 窄屏退化为上下排布：视频变成文字下方的一块 16:9 区域，不再当背景 */
    .hero-media {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      order: 2;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter, .hit { transition: none; }
  }
</style>

<script>
  import { onPageLoad } from '../lib/on-page-load';

  // 模块脚本一次会话只执行一次；视图过渡下每次导航都会触发 astro:page-load，
  // 而字母交互的全部状态都随 DOM 换新，必须在这里整体重建。
  // （导航点击的延迟跳转已下沉到 GooeyNav 组件内部，全站统一生效）
  onPageLoad(() => {
    // 非欢迎页（博客各页导航时也会触发本事件）直接跳过
    const words = document.querySelector('#words');
    const status = document.querySelector('#status');
    if (!words || !status) return;
    let disposed = false;

    // —— 文字变图片交互，移植自 boknows-text-image-template（MIT） ——
    const PHRASE = 'Calm wraps fleeting moments';
    const CONFIG = {
      text: PHRASE,
      // 强制换行的字符位置（该处为空格，撑满整行实现两行排版）：
      // 10 = "Calm wraps | fleeting moments"
      lineBreaks: [10],
      // 首行与次行动态中心对齐（脚本实测两行宽度自动定位，窗口缩放自动重算）
      centerFirstLine: true,
      // 贴图按"位置"挂载（27 项对应 PHRASE 逐字符）：每项为 [图a, 图b, ...] 随机切换；
      // 空数组 = 该字母素材未到位，显示纯文字。同字母跨位置直接复用同一组文件。
      // 命名规范：public/landing/calm-<位置>-<a|b>.webp
      imagesByPosition: [
        ['/landing/calm-00-a.webp', '/landing/calm-00-b.webp'], // 0  C
        ['/landing/calm-01-a.webp', '/landing/calm-01-b.webp'], // 1  a
        ['/landing/calm-02-a.webp', '/landing/calm-02-b.webp'], // 2  l
        ['/landing/calm-03-a.webp', '/landing/calm-03-b.webp'], // 3  m
        [],                                                     // 4  (空格)
        ['/landing/calm-05-a.webp', '/landing/calm-05-b.webp'], // 5  w
        ['/landing/calm-06-a.webp', '/landing/calm-06-b.webp'], // 6  r
        ['/landing/calm-01-a.webp', '/landing/calm-01-b.webp'], // 7  a（复用）
        ['/landing/calm-08-a.webp', '/landing/calm-08-b.webp'], // 8  p
        ['/landing/calm-09-a.webp', '/landing/calm-09-b.webp'], // 9  s
        [],                                                     // 10 (空格)
        ['/landing/calm-11-a.webp', '/landing/calm-11-b.webp'], // 11 f
        ['/landing/calm-02-a.webp', '/landing/calm-02-b.webp'], // 12 l（复用）
        ['/landing/calm-13-a.webp', '/landing/calm-13-b.webp'], // 13 e
        ['/landing/calm-14-a.webp', '/landing/calm-14-b.webp'], // 14 e
        ['/landing/calm-15-a.webp', '/landing/calm-15-b.webp'], // 15 t
        ['/landing/calm-16-a.webp', '/landing/calm-16-b.webp'], // 16 i
        ['/landing/calm-17-a.webp', '/landing/calm-17-b.webp'], // 17 n
        ['/landing/calm-18-a.webp', '/landing/calm-18-b.webp'], // 18 g
        [],                                                     // 19 (空格)
        ['/landing/calm-03-a.webp', '/landing/calm-03-b.webp'], // 20 m（复用）
        ['/landing/calm-21-a.webp', '/landing/calm-21-b.webp'], // 21 o
        ['/landing/calm-03-a.webp', '/landing/calm-03-b.webp'], // 22 m（复用）
        ['/landing/calm-13-b.webp', '/landing/calm-14-a.webp'], // 23 e（复用，交叉搭配）
        ['/landing/calm-17-a.webp', '/landing/calm-17-b.webp'], // 24 n（复用）
        ['/landing/calm-15-a.webp', '/landing/calm-15-b.webp'], // 25 t（复用）
        ['/landing/calm-09-a.webp', '/landing/calm-09-b.webp'], // 26 s（复用）
      ],
      enterDuration: 340,
      exitDuration: 620
    };

    if (CONFIG.exitDuration) {
      document.documentElement.style.setProperty('--exit-duration', CONFIG.exitDuration + 'ms');
    }

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const tokens = Array.from(CONFIG.text);
    const states = [];
    let introTimers = [], autoTimer, hovered = null, inside = false, paused = false, ready = false, inIntro = false, lastAuto = -1, activeQueue = [], visible = true;

    for (let index = 0; index < tokens.length; index++) {
      const ch = tokens[index];
      const isBreak = CONFIG.lineBreaks?.includes(index);
      const el = document.createElement('span');
      el.className = 'letter';
      // 空格字符在独立 flex/grid 元素里会被空白折叠规则压成零宽，需给显式宽度分开单词
      if (ch === ' ') el.classList.add('letter-space');
      // 强制换行位：撑满整行把后续字母挤到下一行
      if (isBreak) el.classList.add('letter-break');
      const char = document.createElement('span');
      char.className = 'char';
      char.textContent = ch;
      el.append(char);
      words.append(el);

      const hit = document.createElement('span');
      hit.className = 'hit' + (isBreak ? ' letter-break' : '');
      hit.dataset.index = index;
      hit.textContent = ch;

      states.push({ el, char, hit, ch, index, loaded: [], last: null, timer: null, active: false });
    }

    const hitLayer = document.createElement('span');
    hitLayer.className = 'hit-layer';
    states.forEach(s => hitLayer.append(s.hit));
    words.append(hitLayer);

    const wordsFontSize = parseFloat(getComputedStyle(words).fontSize);
    // 字母返回动画帧（与原 CSS @keyframes letter-soft-return 一致），WAAPI 播放免重排
    const RETURN_FRAMES = [
      { opacity: 0, transform: 'scale(0.88)', offset: 0 },
      { opacity: 0, transform: 'scale(0.88)', offset: 0.2 },
      { opacity: 1, transform: 'scale(1.035)', offset: 0.65 },
      { opacity: 1, transform: 'scale(1)', offset: 1 }
    ];

    function hide(s) {
      clearTimeout(s.timer);
      const sticker = s.el.querySelector('.sticker');
      const wasActive = s.active;
      s.active = false;
      s.el.classList.remove('active', 'pending');
      if (wasActive) {
        // 返回动画用 WAAPI 直接播放：类名 + void offsetWidth 的重启技巧
        // 会强制浏览器同步重排，划过多个字母时逐个卡一次
        if (!reduced.matches) {
          s.char.animate(RETURN_FRAMES, { duration: 620, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
        }
        if (sticker && !reduced.matches) {
          const pose = getComputedStyle(sticker).transform;
          sticker.getAnimations().forEach(a => a.cancel());
          const exit = sticker.animate([
            { transform: pose, opacity: 1, offset: 0 },
            { transform: `${pose} scale(1.055)`, opacity: 1, offset: 0.2 },
            { transform: `${pose} scale(0.7)`, opacity: 0.42, offset: 0.62 },
            { transform: `${pose} scale(0.35)`, opacity: 0, offset: 1 }
          ], { duration: CONFIG.exitDuration || 620, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' });
          exit.onfinish = () => sticker.remove();
        } else sticker?.remove();
      }
      s.el.style.paddingInline = '0em';
      s.hit.style.paddingInline = '0em';
    }

    function clearIntro() {
      introTimers.forEach(clearTimeout);
      introTimers = [];
      inIntro = false;
      states.forEach(s => { s.el.classList.remove('pending'); hide(s); });
    }

    function returnLater(s, ms) {
      clearTimeout(s.timer);
      s.timer = setTimeout(() => { if (hovered !== s.index) hide(s); }, ms);
    }

    function springFrames(angle, y) {
      return Array.from({ length: 41 }, (_, i) => {
        const t = i / 40;
        const value = i === 40 ? 1 : 1 - Math.exp(-7.2 * t) * (Math.cos(10.5 * t) + 0.24 * Math.sin(10.5 * t));
        return { offset: t, transform: `translateY(${y + 8 * (1 - value)}px) rotate(${angle - 8 * (1 - value)}deg) scale(${0.35 + 0.65 * value})` };
      });
    }

    function show(s, { intro = false, automatic = false } = {}) {
      if (reduced.matches || !s.loaded.length) return;
      if (!intro && inIntro) clearIntro();
      clearTimeout(s.timer);

      const pool = s.loaded.filter(a => a !== s.last);
      const items = pool.length ? pool : s.loaded;
      const src = items[Math.floor(Math.random() * items.length)];
      s.last = src;
      s.active = true;
      s.el.classList.remove('pending');
      s.el.classList.add('active');
      s.el.querySelector('.sticker')?.remove();

      const sticker = document.createElement('span');
      sticker.className = 'sticker';
      const image = document.createElement('img');
      image.src = src;
      image.alt = '';
      image.draggable = false;
      sticker.append(image);
      s.el.append(sticker);

      s.el.style.setProperty('--height', ['o', 'w'].includes(s.ch) ? '1.18em' : '1.08em');
      s.el.style.setProperty('--maxwidth', '1.377em');
      s.el.style.setProperty('--offset', '0em');

      const fontSize = wordsFontSize;

      const imageWidth = s.imageWidths?.get(src) || 1.08;
      const glyphWidth = s.glyphW ??= s.char.getBoundingClientRect().width / fontSize;
      const expandedPadding = Math.min(0.18, Math.max(0.10, (imageWidth - glyphWidth) * 0.22));
      let padding = expandedPadding;
      if (intro) {
        // 开场限宽仅 intro 需要；平时悬停跳过这 7 次 getBoundingClientRect 强制布局
        const baseWidth = states.reduce((sum, item) => sum + item.char.getBoundingClientRect().width, 0);
        const openingLimit = Math.max(0, (words.clientWidth - baseWidth - 24) / (2 * states.length * fontSize));
        padding = Math.min(expandedPadding, openingLimit);
      }
      s.el.style.paddingInline = s.hit.style.paddingInline = `${padding}em`;

      const angle = [-9, 7, -5, 8, -7, 6, -4][s.index % 7];
      const y = [3, -2, 2, -3, 1, 3, -1][s.index % 7];
      sticker.animate(springFrames(angle, y), { duration: CONFIG.enterDuration || 340, fill: 'both' });

      activeQueue = activeQueue.filter(i => i !== s.index);
      activeQueue.push(s.index);
      if (!intro) while (activeQueue.length > 4) hide(states[activeQueue.shift()]);

      if (!intro && hovered !== s.index) returnLater(s, automatic ? 1000 : 420);
    }

    function introDuration() {
      return 85 * Math.max(0, states.filter(s => s.loaded.length).length - 1) + 660;
    }

    function schedule(first = false) {
      clearTimeout(autoTimer);
      if (!ready || paused || inside || document.hidden || !visible || reduced.matches) return;
      autoTimer = setTimeout(() => {
        let available = states.filter(s => s.loaded.length && s.index !== lastAuto);
        if (!available.length) available = states.filter(s => s.loaded.length);
        if (!available.length) return;
        const s = available[Math.floor(Math.random() * available.length)];
        lastAuto = s.index;
        show(s, { automatic: true });
        schedule();
      }, first ? introDuration() + 1000 + 1000 * Math.random() : 1300 + 1500 * Math.random());
    }

    function start() {
      clearTimeout(autoTimer);
      clearIntro();
      activeQueue = [];
      if (reduced.matches) { status.textContent = '已遵循系统的减少动态效果设置'; return; }
      inIntro = true;
      const items = states.filter(s => s.loaded.length);
      items.forEach(s => s.el.classList.add('pending'));
      items.forEach((s, i) => introTimers.push(setTimeout(() => show(s, { intro: true }), i * 40)));
      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      shuffled.forEach((s, i) => introTimers.push(setTimeout(() => hide(s), 40 * Math.max(0, items.length - 1) + 660 + 45 * i)));
      introTimers.push(setTimeout(() => {
        inIntro = false;
        status.textContent = '将鼠标移到字母上，看看它会变成什么';
      }, introDuration()));
      schedule(true);
    }

    function point(event) {
      inside = true;
      clearTimeout(autoTimer);
      const hit = document.elementFromPoint(event.clientX, event.clientY)?.closest('[data-index]');
      const next = hit && words.contains(hit) ? Number(hit.dataset.index) : null;
      if (next === hovered) return;
      const old = hovered;
      hovered = next;
      if (old !== null && states[old].active) hide(states[old]);
      if (next !== null) show(states[next]);
    }

    // 字母交互的命中检测 + 贴纸增删有布局开销，高频鼠标（125~1000Hz）下
    // 每个事件都跑一遍会和视频 seek 解码抢主线程（表现为划过字母区时人物卡顿），
    // 与视频侧同款策略：处理频率锁到显示器刷新率，一帧最多取最新坐标处理一次
    let pointRafId = 0;
    let queuedPoint = null;
    function pointOnRaf(e) {
      queuedPoint = e;
      if (!pointRafId) {
        pointRafId = requestAnimationFrame(() => {
          pointRafId = 0;
          if (!disposed && queuedPoint) {
            const ev = queuedPoint;
            queuedPoint = null;
            point(ev);
          }
        });
      }
    }

    words.addEventListener('pointerenter', () => { inside = true; clearTimeout(autoTimer); });
    words.addEventListener('pointermove', pointOnRaf);
    words.addEventListener('pointerdown', pointOnRaf);

    function leave() {
      inside = false;
      const old = hovered;
      hovered = null;
      if (old !== null && states[old].active) hide(states[old]);
      schedule(true);
    }
    words.addEventListener('pointerleave', leave);
    words.addEventListener('pointercancel', leave);
    words.addEventListener('pointerup', e => { if (e.pointerType !== 'mouse') leave(); });

    const onVisibility = () => {
      if (document.hidden) { clearTimeout(autoTimer); if (inIntro) clearIntro(); }
      else schedule(true);
    };
    document.addEventListener('visibilitychange', onVisibility);

    const io = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      schedule(true);
    }, { threshold: 0.25 });
    io.observe(words);

    const onReducedChange = () => {
      if (reduced.matches) { clearIntro(); clearTimeout(autoTimer); }
      else if (ready) start();
    };
    reduced.addEventListener('change', onReducedChange);

    async function load(s, src) {
      const im = new Image();
      im.src = src;
      try {
        await im.decode();
        s.loaded.push(src);
        s.imageWidths ??= new Map();
        s.imageWidths.set(src, Math.min(('ow'.includes(s.ch) ? 1.18 : 1.08) * im.naturalWidth / im.naturalHeight, 1.377));
        let width = Math.min(1.32 * im.naturalWidth / im.naturalHeight, 1.62);
        try {
          const canvas = document.createElement('canvas');
          const scale = Math.min(1, 160 / Math.max(im.naturalWidth, im.naturalHeight));
          canvas.width = Math.max(1, Math.round(im.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(im.naturalHeight * scale));
          const ctx = canvas.getContext('2d', { willReadFrequently: true });
          ctx.drawImage(im, 0, 0, canvas.width, canvas.height);
          const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
          let left = canvas.width, right = -1;
          for (let y = 0; y < canvas.height; y++) {
            for (let x = 0; x < canvas.width; x++) {
              if (data[(y * canvas.width + x) * 4 + 3] > 8) {
                left = Math.min(left, x);
                right = Math.max(right, x);
              }
            }
          }
          if (right >= left) width = (right - left + 1) / scale * Math.min(1.32 / im.naturalHeight, 1.62 / im.naturalWidth);
        } catch {}
        s.padding = s.padding ?? new Map();
        s.padding.set(src, Math.max(0.12, (width / 1.62) * 0.28) * 0.85 * 0.85);
      } catch {}
    }

    Promise.all(states.flatMap((s, i) => CONFIG.imagesByPosition[i].map(src => load(s, src)))).then(() => {
      if (disposed) return;
      states.forEach((s, i) => s.loaded.sort((a, b) => CONFIG.imagesByPosition[i].indexOf(a) - CONFIG.imagesByPosition[i].indexOf(b)));
      ready = true;
      start();
    });

    // —— 首行动态居中：实测两行渲染宽度，把第一行精确移到与第二行中心对齐 ——
    function centerFirstLine() {
      const breakAt = CONFIG.lineBreaks?.[0];
      if (!CONFIG.centerFirstLine || !breakAt || breakAt >= states.length - 1) return;
      const a1 = states[0].el, a2 = states[breakAt - 1].el;
      const b1 = states[breakAt + 1].el, b2 = states[states.length - 1].el;
      const w1 = a2.getBoundingClientRect().right - a1.getBoundingClientRect().left;
      const w2 = b2.getBoundingClientRect().right - b1.getBoundingClientRect().left;
      const dx = Math.max(0, (w2 - w1) / 2);
      states[0].el.style.marginLeft = dx + 'px';
      states[0].hit.style.marginLeft = dx + 'px';
    }
    centerFirstLine();
    // 字体（Cormorant italic）异步加载会改变字母宽度，加载完成后必须重算，
    // 并移除 font-loading 隐藏：字体就绪 + 居中完成后才显示，消除刷新时的字体/位置闪变
    const revealWords = () => { if (!disposed) words.classList.remove('font-loading'); };
    if (document.fonts) {
      document.fonts.ready.then(() => { if (!disposed) { centerFirstLine(); revealWords(); } });
      setTimeout(revealWords, 2000); // 兜底：字体加载异常时最多隐藏 2 秒
    } else {
      revealWords();
    }
    const onResizeCenter = () => centerFirstLine();
    window.addEventListener('resize', onResizeCenter);

    // 离开页面时停掉全部定时器与 document 级监听；
    // 绑在 words 等被换掉 DOM 上的监听随旧元素一起回收，无需处理
    return () => {
      disposed = true;
      clearIntro();
      clearTimeout(autoTimer);
      if (pointRafId) cancelAnimationFrame(pointRafId);
      document.removeEventListener('visibilitychange', onVisibility);
      reduced.removeEventListener('change', onReducedChange);
      window.removeEventListener('resize', onResizeCenter);
      io.disconnect();
    };
  });

  // —— 右侧人物视频：鼠标横向相对位移擦洗时间轴 ——
  // 加载后保持暂停；指针横向位移 × 0.08 帧/px 累加进独立的"逻辑目标时间"，
  // 视频只负责追赶账本（seek 进行中到达的新目标由 seeked 串联补跳）。
  // 关键：逻辑账本与视频实际进度解耦——快速滑动时 seek 异步未完成、
  // currentTime 迟滞，若以它为基准累加会丢失位移（表现为"划到底只转了一半"）。
  // 推到最左/最右帧后原地饱和。触屏与减动效不绑监听，静止正面帧。
  onPageLoad(() => {
    const v = document.querySelector('#hero-video');
    if (!v) return;
    const FPS = 24;
    const FRAMES_PER_PX = 0.08;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let lastX = null;
    let pending = null;   // 已发出、可能尚未完成的 seek 目标
    let target = null;    // 逻辑目标时间（秒），唯一事实来源
    let seekQueued = false;
    let alive = true;

    function clampTime(t) {
      return Math.min(v.duration - 0.5 / FPS, Math.max(0, t));
    }

    function seekTo(t) {
      // 帧粒度去重：目标帧与在途/当前帧相同（移动不足半帧、或已推到端点）时
      // 跳过 seek，避免"解码半天目标帧没变"的无效功——这是滑动卡顿的主因之一
      if (pending !== null && Math.abs(t - pending) < 0.5 / FPS) return;
      if (pending === null && Math.abs(t - v.currentTime) < 0.5 / FPS) return;
      pending = t;
      if (!v.seeking) v.currentTime = t;
    }

    // seek 完成时若期间产生了更新的目标，立刻补一次 seek（串联防丢帧）
    function onSeeked() {
      if (!alive) return;
      if (pending !== null && Math.abs(v.currentTime - pending) > 0.5 / FPS) {
        v.currentTime = pending;
      } else {
        pending = null;
      }
    }

    function onMove(e) {
      if (e.pointerType === 'touch') { lastX = null; return; }
      if (lastX === null || target === null) { lastX = e.clientX; return; }
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      if (!dx) return;
      target = clampTime(target + (dx * FRAMES_PER_PX) / FPS);
      // seek 发射频率锁到显示器刷新率：高频鼠标（125~1000Hz）的事件风暴
      // 会让 seek 排队溢出，这里每帧最多发一次、总是取最新目标
      if (!seekQueued) {
        seekQueued = true;
        requestAnimationFrame(() => { seekQueued = false; if (alive) seekTo(target); });
      }
    }

    function onLeave() { lastX = null; }

    // 后台标签页返回后 Chromium 会回收已解码的视频帧（暂停中的视频没有新事件
    // 触发重绘 → 整层渲染成黑块），重新 seek 一次强制解码器出新帧
    function onVisibility() {
      if (!document.hidden && alive && target !== null && v.readyState >= 1) {
        pending = null;
        v.currentTime = clampTime(target);
      }
    }
    document.addEventListener('visibilitychange', onVisibility);

    function bind() {
      // 触屏 / 减动效：不注入 src，视频 0 流量，静止 poster 即正面帧画面
      if (reduced.matches || !matchMedia('(hover: hover)').matches) return;
      // 可交互设备：此时才注入 src 开始加载；元数据到位后定位正面帧并接管交互
      v.addEventListener('loadedmetadata', () => {
        if (!alive) return;
        target = v.duration / 2;   // 初始定位到中间正面帧，与海报一致
        v.currentTime = target;
        v.addEventListener('seeked', onSeeked);
        document.addEventListener('pointermove', onMove);
        document.documentElement.addEventListener('mouseleave', onLeave);
      }, { once: true });
      v.preload = 'auto';
      v.src = '/landing/hero-character.mp4';
    }

    bind();

    return () => {
      alive = false;
      document.removeEventListener('pointermove', onMove);
      document.documentElement.removeEventListener('mouseleave', onLeave);
      document.removeEventListener('visibilitychange', onVisibility);
      v.removeEventListener('seeked', onSeeked);
      v.removeAttribute('src');
      v.load(); // 中断可能仍在进行的视频下载（视图过渡换页时）
    };
  });

  // —— 樱花氛围层：Canvas 粒子全屏飘落 ——
  // 设计约定（grill-me 决策）：哑光柔粉贴合米白暖橙基调；飘在内容前面但透明度压低；
  // 减动效用户完全不渲染；粒子数按视口面积缩放（小屏最低减半）；DPR 上限 2。
  // dt 用 rAF 时间差驱动（速度单位 = px/s），后台标签页 rAF 自动暂停，
  // 回前台时 dt 钳制防花瓣瞬移，无需额外 visibilitychange 监听。
  onPageLoad(() => {
    const canvas = document.querySelector('#sakura-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return; // 减动效：一根花瓣都不画

    // ===== 参数（调这里，dev 模式改完即时生效）=====
    const CONFIG = {
      count: 90,        // 桌面端花瓣数量（按视口面积自动缩放，小屏最低 50%）
      speed: 50,        // 基础飘落速度 px/s（个体有 0.6~1.4 倍随机因子）
      wind: 25,         // 水平风向漂移 px/s（负值向左）
      sway: 16,         // 左右摇摆速度幅度 px/s（正弦摆动，模拟空气扰动）
      size: [5, 10],    // 花瓣长半径范围 px（短半径约 0.55~0.75 倍）
      opacity: 0.95,    // 整体透明度上限（压低保证正文可读性）
    }

    // 花瓣三档色阶从 token 读取（tokens.css 樱花段），换肤时自动跟随；
    // 自定义属性的计算值已完成 var() 展开，直接取即可
    const css = getComputedStyle(document.documentElement);
    const PALETTE = [
      css.getPropertyValue('--sakura-petal-light').trim() || '#FBD9DF',
      css.getPropertyValue('--sakura-petal').trim() || '#F5B8C4',
      css.getPropertyValue('--sakura-petal-deep').trim() || '#EE9FB2',
    ];

    let w = 0, h = 0;
    const petals = [];

    function makePetal(spawnAnywhere) {
      const size = CONFIG.size[0] + Math.random() * (CONFIG.size[1] - CONFIG.size[0]);
      return {
        x: Math.random() * w,
        y: spawnAnywhere ? Math.random() * h : -size * 2,
        rx: size,
        ry: size * (0.55 + Math.random() * 0.2),
        angle: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 1.6,                 // 翻转角速度 rad/s
        fall: CONFIG.speed * (0.6 + Math.random() * 0.8),  // 个体下落速度
        drift: CONFIG.wind * (0.5 + Math.random()),        // 个体风向因子
        swayPhase: Math.random() * Math.PI * 2,
        swaySpeed: 0.8 + Math.random() * 0.8,              // 摆动角速度 rad/s
        alpha: 0.5 + Math.random() * 0.5,
        color: PALETTE[(Math.random() * PALETTE.length) | 0],
      };
    }

    function targetCount() {
      // 1440×900 为满额基准，视口越小粒子越少，下限减半
      const scale = Math.max(0.5, Math.min(1, (w * h) / (1440 * 900)));
      return Math.round(CONFIG.count * scale);
    }

    function syncCount() {
      const target = targetCount();
      while (petals.length < target) petals.push(makePetal(true));
      if (petals.length > target) petals.length = target;
    }

    function resize() {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      syncCount();
    }

    // 单片樱花瓣路径：顶端带 V 形缺口的泪滴形（真樱花瓣的标志特征），
    // 而不是素椭圆——同样的每帧开销，辨识度完全不同
    function drawPetal(p) {
      const { rx, ry } = p;
      const notch = rx * 0.35;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      ctx.globalAlpha = p.alpha * CONFIG.opacity;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.moveTo(-rx, 0);
      ctx.quadraticCurveTo(-rx, -ry * 0.8, -notch, -ry); // 左肩
      ctx.lineTo(0, -ry * 0.7);                          // V 形缺口谷底
      ctx.lineTo(notch, -ry);                            // 右肩
      ctx.quadraticCurveTo(rx, -ry * 0.8, rx, 0);
      ctx.quadraticCurveTo(rx * 0.6, ry, 0, ry);         // 圆润瓣底
      ctx.quadraticCurveTo(-rx * 0.6, ry, -rx, 0);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    let rafId = 0;
    let running = false;
    let last = 0;

    function step(now) {
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i];
        p.angle += p.spin * dt;
        p.swayPhase += p.swaySpeed * dt;
        p.y += p.fall * dt;
        p.x += (p.drift + Math.sin(p.swayPhase) * CONFIG.sway) * dt;
        // 出界回收：落出底部从顶部重生，横向环绕穿屏
        if (p.y - p.rx > h) Object.assign(p, makePetal(false));
        if (p.x < -p.rx * 2) p.x = w + p.rx * 2;
        else if (p.x > w + p.rx * 2) p.x = -p.rx * 2;
        drawPetal(p);
      }
      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (running) return;
      running = true;
      last = performance.now();
      rafId = requestAnimationFrame(step);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
      ctx.clearRect(0, 0, w, h);
    }

    const onResize = () => resize();
    window.addEventListener('resize', onResize);

    // 运行中切换系统减动效设置：开 = 停止并清空；关 = 恢复
    const onReducedChange = () => (reduced.matches ? stop() : start());
    reduced.addEventListener('change', onReducedChange);

    resize();
    start();

    return () => {
      running = false;
      cancelAnimationFrame(rafId);
      window.removeEventListener('resize', onResize);
      reduced.removeEventListener('change', onReducedChange);
    };
  });
</script>
