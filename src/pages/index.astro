---
// 欢迎页 — 落羽闲笺 (Decora 风格)
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>落羽闲笺 — 世界那么大，我先溜达溜达</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    .landing {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      background: #F7F9F5;
    }

    .bg-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
      pointer-events: none;
      opacity: 0.4;
    }

    .content {
      position: relative;
      z-index: 1;
      text-align: center;
      color: var(--text-primary, #2F3B33);
      animation: fadeUp 1.2s ease-out both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .site-name {
      font-family: 'LXGW WenKai', serif;
      font-size: 3.5rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      margin-bottom: 0.6rem;
      color: #4E9573;
      text-shadow: 3px 3px 0 rgba(245, 184, 196, 0.6);
    }


    .tagline {
      font-family: 'LXGW WenKai', serif;
      font-size: 1.2rem;
      color: #94A29A;
      letter-spacing: 0.08em;
      margin-bottom: 2.5rem;
      font-weight: 600;
    }

    .enter-btn {
      display: inline-block;
      font-family: 'LXGW WenKai', serif;
      font-size: 1.1rem;
      font-weight: 800;
      color: #ffffff;
      background: #5FA986;
      border: 4px solid #5FA986;
      padding: 0.7em 2.4em;
      border-radius: 999px;
      text-decoration: none;
      letter-spacing: 0.12em;
      box-shadow: 0 4px 14px rgba(95, 169, 134, 0.35);
      transition: all 0.2s;
    }

    .enter-btn:hover {
      background: #4E9573;
      border-color: #4E9573;
      color: #ffffff;
      transform: scale(1.05);
    }

  </style>
</head>
<body>
  <div class="landing">
    <video class="bg-video" autoplay muted loop playsinline>
      <source src="/landing-bg.mp4" type="video/mp4" />
    </video>

    <div class="content">
      <h1 class="site-name">落羽闲笺</h1>
      <p class="tagline">世界那么大，我先溜达溜达</p>
      <a href="/blog" class="enter-btn">进入博客</a>
    </div>
  </div>
  <script>
    const video = document.querySelector('.bg-video');
    video.addEventListener('loadedmetadata', () => {
      if (video.videoHeight > video.videoWidth) {
        video.style.width = '100vh';
        video.style.height = '100vw';
        video.style.top = '50%';
        video.style.left = '50%';
        video.style.inset = 'auto';
        video.style.transform = 'translate(-50%, -50%) rotate(-90deg)';
      }
    });
  </script>
</body>
</html>
