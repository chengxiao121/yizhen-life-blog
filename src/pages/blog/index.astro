---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import RightSidebar from '../../components/RightSidebar.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import { getPublishedPosts } from '../../lib/posts';

const sortedPosts = await getPublishedPosts();
---

<BaseLayout title="首页" mainClass="blog-main" showCategorySidebar={true}>
  <div class="journal-layout">
    <div class="main-content">
      <!-- Hero 欢迎横幅 -->
      <HeroBanner />

      <!-- 文章列表 -->
      <div class="posts-collage">
        <div class="posts-list">
          {sortedPosts.map((post, index) => (
            <div class="post-row" style={`animation-delay: ${0.1 + index * 0.06}s;`}>
              <PostCard
                title={post.data.title}
                slug={post.slug}
                date={post.data.date}
                description={post.data.description}
                tags={post.data.tags}
                category={post.data.category}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <RightSidebar slot="right-sidebar" currentCategory="" />
</BaseLayout>

<style>
  .journal-layout {
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* 文章单列列表 */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .post-row {
    animation: fadeInUp 0.5s ease-out both;
  }

  /* ===== 响应式 ===== */
  @media (max-width: 768px) {
    .posts-list {
      gap: 0.9rem;
    }
  }
</style>
