---
// 顶栏：logo + 搜索 + 移动端导航（≤1100px 时显示）
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/blog', label: '首页', active: currentPath === '/blog' || currentPath === '/' },
  { href: '/tech', label: '技术', active: currentPath.startsWith('/tech') },
  { href: '/life', label: '生活', active: currentPath.startsWith('/life') },
  { href: '/photos', label: '照片墙', active: currentPath.startsWith('/photos') },
  { href: '/about', label: '关于我', active: currentPath === '/about' },
];
---

<header class="site-header">
  <nav class="nav">
    <a href="/" class="logo">
      <span class="logo-text">落羽闲笺</span>
    </a>

    <!-- 移动端水平导航 -->
    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class:list={["nav-link", { active: item.active }]}>{item.label}</a>
        </li>
      ))}
    </ul>

    <!-- 搜索框：搜索功能开发中，点击提示 -->
    <form class="search-box" onsubmit="return false;">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.5" y2="16.5" />
      </svg>
      <input
        type="search"
        class="search-input"
        placeholder="搜索文章…"
        aria-label="搜索文章"
        data-search-input
      />
      <span class="search-toast" data-search-toast>功能开发中</span>
    </form>
  </nav>
</header>

<script>
  const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
  const toast = document.querySelector('[data-search-toast]') as HTMLElement | null;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  const showToast = () => {
    if (!toast) return;
    toast.classList.add('visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('visible'), 2500);
  };

  if (input) {
    input.addEventListener('click', showToast);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        showToast();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.5rem 1.5rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid rgba(228, 235, 228, 0.8);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 48px;
    max-width: 1280px;
    margin: 0 auto;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-text {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  /* 移动端导航 — 桌面端隐藏 */
  .nav-links {
    display: none;
    list-style: none;
    gap: 0.3rem;
    align-items: center;
  }

  .nav-link {
    display: inline-block;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .nav-link.active {
    color: #ffffff;
    background: var(--accent);
  }

  /* ── 搜索框 ── */
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4em 1em;
    background: var(--tag-gray);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  /* 搜索开发中提示气泡 */
  .search-toast {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    white-space: nowrap;
    padding: 0.55em 1em;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 101;
  }

  .search-toast::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 24px;
    width: 8px;
    height: 8px;
    background: #ffffff;
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .search-toast.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .search-box:focus-within {
    border-color: rgba(143, 203, 168, 0.7);
    background: #ffffff;
  }

  .search-icon {
    width: 15px;
    height: 15px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input {
    border: none;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--text-primary);
    width: 140px;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  /* ── 响应式 ── */
  @media (max-width: 1100px) {
    .nav-links {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 0.4rem 1rem;
    }
    .search-input {
      width: 90px;
    }
  }

  @media (max-width: 480px) {
    .nav-link {
      padding: 0.35em 0.6em;
      font-size: 0.72rem;
    }
    .search-input {
      width: 70px;
    }
  }
</style>
