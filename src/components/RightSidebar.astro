---
import CategorySidebar from './CategorySidebar.astro';
import PhotoCarousel from './PhotoCarousel.astro';
import RandomQuote from './RandomQuote.astro';
// 数据读取方式与照片页统一：直接 import（构建期内联），禁止 fs.readFileSync
import photosData from '../../public/data/photos.json';
import quotesData from '../../public/data/quotes.json';

interface Props {
  currentCategory?: string;
}

const { currentCategory = '' } = Astro.props;

const allPhotos = photosData.photos || [];

// 随机选取 5 张照片
const shuffled = [...allPhotos].sort(() => Math.random() - 0.5);
const selectedPhotos = shuffled.slice(0, 5).map((p) => ({
  id: p.id,
  path: p.path,
  title: p.title || p.description || '',
}));

const quotes: string[] = Array.isArray(quotesData) ? quotesData : [];
---

<aside class="right-sidebar">
  <!-- 关于我卡片 -->
  <div class="about-card">
    <p class="about-hello">Hi，我是可乐加冰 ✦</p>
    <p class="about-desc">一名爱溜达的学生，这里是我的小小宇宙，记录代码与生活的片段。</p>
    <a href="/about" class="about-link">认识一下 →</a>
  </div>

  <!-- 分类卡片 -->
  <CategorySidebar currentCategory={currentCategory} />

  <!-- 照片轮播 + 随机句子 -->
  <div class="sidebar-section carousel-section">
    <PhotoCarousel photos={selectedPhotos} />
    <div class="quote-wrapper">
      <RandomQuote quotes={quotes} />
    </div>
  </div>
</aside>

<style>
  .right-sidebar {
    position: sticky;
    top: 92px;
    width: 230px;
    flex-shrink: 0;
    align-self: flex-start;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .about-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.3rem 1.2rem;
    box-shadow: var(--shadow);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .about-card:hover {
    border-color: var(--accent-border);
    box-shadow: var(--shadow-hover);
  }

  .about-hello {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .about-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0.8rem;
  }

  .about-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-hover);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .about-link:hover {
    color: var(--accent);
  }

  .sidebar-section {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .sidebar-section.carousel-section {
    padding: 0;
    overflow: hidden;
  }

  .quote-wrapper {
    padding: 0.125rem 1rem;
    border-top: 1px solid var(--border);
  }

  .sidebar-section:hover {
    border-color: var(--accent-border);
  }

  /* 响应式：≤1100px 时隐藏右侧边栏 */
  @media (max-width: 1100px) {
    .right-sidebar {
      display: none;
    }
  }
</style>
