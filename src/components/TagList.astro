---
interface Props {
  tags: string[];
  linkable?: boolean;
}

const { tags, linkable = true } = Astro.props;

const tagColors: Record<string, { bg: string; text: string }> = {
  '技术': { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-secondary)' },
  '生活': { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-secondary)' },
  '随笔': { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-secondary)' },
  'Astro': { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-secondary)' },
};

const defaultColor = { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-secondary)' };
---

<div class="tag-list">
  {tags.map((tag) => {
    const color = tagColors[tag] || defaultColor;
    return linkable ? (
      <a href={`/tags/${tag}`} class="tag" style={`background: ${color.bg}; color: ${color.text};`}>
        {tag}
      </a>
    ) : (
      <span class="tag" style={`background: ${color.bg}; color: ${color.text};`}>{tag}</span>
    );
  })}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    display: inline-block;
    padding: 0.15em 0.7em;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
    transition: transform 0.2s;
    border: none;
    letter-spacing: 0.03em;
  }
  .tag:hover {
    transform: scale(1.08);
  }
  a.tag:hover {
    opacity: 0.9;
  }
</style>
