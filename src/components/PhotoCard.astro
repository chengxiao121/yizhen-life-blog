---
interface Props {
  id: string;
  path: string;
  title?: string;
  date: string;
  width: number;
  height: number;
}

const { id, path, title, date, width, height } = Astro.props;
---

<div
  class="photo-card"
  data-id={id}
  data-src={path}
  data-width={width}
  data-height={height}
  data-title={title}
  data-date={date}
>
  <img
    src={path}
    alt={title || '照片'}
    loading="lazy"
    width={width}
    height={height}
  />
  <div class="photo-error" style="display:none">
    <span>图片加载失败</span>
  </div>
</div>

<script>
  import { onPageLoad } from '../lib/on-page-load';

  // 加载态统一在此绑定，禁止改回内联 onload/onerror
  // 视图过渡返回后图片是全新元素，必须在每次页面载入时重新绑定
  onPageLoad(() => {
    const imgs = document.querySelectorAll<HTMLImageElement>('.photo-card img');
    imgs.forEach((img) => {
      const show = () => img.classList.add('loaded');
      const fail = () => {
        img.classList.add('error');
        const err = img.parentElement?.querySelector<HTMLElement>('.photo-error');
        if (err) err.style.display = 'flex';
      };
      if (img.complete) {
        img.naturalWidth > 0 ? show() : fail();
      } else {
        img.addEventListener('load', show);
        img.addEventListener('error', fail);
      }
    });
  });
</script>
