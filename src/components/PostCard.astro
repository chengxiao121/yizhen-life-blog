---
import TagList from './TagList.astro';

interface Props {
  title: string;
  slug: string;
  date: string;
  description: string;
  tags: string[];
  category?: string;
  featured?: boolean;
}

const { title, slug, date, description, tags, category, featured = false } = Astro.props;

// 格式化日期
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
};

---

<article class:list={["post-card", { featured }]}>
  <a href={`/posts/${slug}`} class="post-card-link">
    <div class="card-header">
      {category && <span class="post-category">{category}</span>}
      <TagList tags={tags} />
    </div>
    <h2 class="post-title">{title}</h2>
    <p class="post-desc">{description}</p>
  </a>
  <div class="card-footer">
    <time class="post-date">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M3 9h18M8 3v4M16 3v4" />
      </svg>
      {formatDate(date)}
    </time>
    <span class="card-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="12" x2="20" y2="12" />
        <polyline points="13 5 20 12 13 19" />
      </svg>
    </span>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    background: var(--bg-card);
    border-radius: 20px;
    padding: 1.4rem 1.6rem 1.1rem;
    border: 1px solid var(--border);
    overflow: visible;
    box-shadow: var(--shadow);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.15s ease;
  }

  .post-card:hover {
    border-color: rgba(143, 203, 168, 0.6);
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  .post-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card-link:hover {
    color: inherit;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .post-category {
    display: inline-block;
    padding: 0.2em 0.8em;
    border: none;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--tag-green-text);
    background: var(--tag-green);
  }

  .post-title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .post-card:hover .post-title {
    color: var(--accent-hover);
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.9rem;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .post-date svg {
    width: 13px;
    height: 13px;
  }

  .card-arrow {
    display: inline-flex;
    color: var(--text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .card-arrow svg {
    width: 16px;
    height: 16px;
  }

  .post-card:hover .card-arrow {
    color: var(--accent-hover);
    transform: translateX(3px);
  }

  /* 特色卡片样式 */
  .post-card.featured {
    padding: 1.8rem 2rem 1.4rem;
  }

  .post-card.featured .post-title {
    font-size: 1.35rem;
  }

  .post-card.featured .post-desc {
    -webkit-line-clamp: 3;
    font-size: 0.92rem;
  }
</style>
