---
import { getPublishedPosts } from '../lib/posts';

interface Props {
  currentCategory?: string;
}

const { currentCategory = '' } = Astro.props;

// 获取所有已发布文章
const allPosts = await getPublishedPosts();

// 定义分类列表（必须与 schema 枚举一致，禁止加无路由页的分类）
const categories = [
  { name: '技术', slug: 'tech' },
  { name: '生活', slug: 'life' },
];

// 统计每个分类的文章数量
const categoryCounts = categories.map(cat => {
  const count = allPosts.filter(post => post.data.category === cat.name).length;
  return { ...cat, count };
});
---

<aside class="category-sidebar">
  <div class="category-card">
    <h3 class="category-title">文章分类</h3>
    <ul class="category-list">
      {categoryCounts.map(cat => (
        <li class="category-item">
          <a
            href={`/${cat.slug}`}
            class:list={['category-link', { active: currentCategory === cat.slug }]}
          >
            <span class="category-name">{cat.name}</span>
            <span class="category-count">{cat.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .category-sidebar {
    width: 100%;
    animation: fadeInUp 0.6s ease-out;
  }

  .category-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.2rem;
    overflow: visible;
    box-shadow: var(--shadow);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--accent-border);
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }

  .category-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px dashed var(--border);
    letter-spacing: 0.04em;
  }

  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-item {
    margin-bottom: 0;
  }

  .category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 0.8rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.15s ease;
    border: 1.5px solid transparent;
  }

  .category-link:hover {
    background: var(--accent-light);
    color: var(--accent-hover);
    transform: translateX(3px);
  }

  .category-link.active {
    background: var(--accent-light);
    color: var(--accent-hover);
    border-color: var(--accent-border);
    box-shadow: 0 2px 8px rgba(95, 169, 134, 0.12);
  }

  .category-name {
    letter-spacing: 0.02em;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .category-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    transition: color 0.25s ease;
  }

  .category-link:hover .category-count,
  .category-link.active .category-count {
    color: var(--accent-hover);
  }


  /* 响应式：≤1100px 时隐藏 */
  @media (max-width: 1100px) {
    .category-sidebar {
      display: none;
    }
  }
</style>
