---
interface Props {
  quotes: string[];
}

const { quotes } = Astro.props;
// 随机在客户端进行（每次访问都不同）；构建期只渲染兜底文案
const FALLBACK = '世界那么大，我先溜达溜达。';
---

<div
  class="random-quote"
  data-quotes={JSON.stringify(quotes)}
  data-fallback={FALLBACK}
>
  <p class="quote-text">
    <span class="quote-mark">"</span>
    <span class="quote-body">{FALLBACK}</span>
    <span class="quote-mark">"</span>
  </p>
</div>

<script>
  import { onPageLoad } from '../lib/on-page-load';

  // 视图过渡返回后 DOM 全新，必须重新随机（否则永远停在兜底文案）
  onPageLoad(() => {
    document.querySelectorAll<HTMLElement>('.random-quote').forEach((el) => {
      const body = el.querySelector<HTMLElement>('.quote-body');
      if (!body) return;
      let pool: string[] = [];
      try {
        pool = JSON.parse(el.dataset.quotes || '[]');
      } catch {
        pool = [];
      }
      if (pool.length === 0) pool = [el.dataset.fallback || ''];
      body.textContent = pool[Math.floor(Math.random() * pool.length)];
    });
  });
</script>

<style>
  .random-quote {
    text-align: center;
    padding: 0;
  }

  .quote-text {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.7;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .quote-mark {
    color: var(--deco-pink);
    font-weight: 700;
    font-size: 1rem;
    font-style: normal;
  }
</style>
