---
import Header from '../components/Header.astro';
import SiteStats from '../components/SiteStats.astro';
import ParticlesBackground from '../components/ParticlesBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
  noSidebar?: boolean;
  showCategorySidebar?: boolean;
}

const { title, description = '一帧.life - 世界那么大，我先溜达溜达', mainClass = '', noSidebar = false, showCategorySidebar = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai&display=swap" rel="stylesheet" />
  <title>{title} | 一帧.life</title>
</head>
<body>
  <!-- WebGL 粒子背景 — 最底层 -->
  <ParticlesBackground
    particleColors={["#F97316"]}
    particleCount={600}
    particleSpread={10}
    speed={0.1}
    particleBaseSize={100}
    moveParticlesOnHover={false}
    alphaParticles={false}
    disableRotation={false}
    pixelRatio={5}
  />

  <!-- 顶部背景图区域 — 正常滚动 -->
  <div class="hero-bg">
    <img class="hero-bg-img" src="/page-bg.png" alt="" aria-hidden="true" />
  </div>

  <!-- 波浪 SVG — JS 动态定位到 hero 底部，滚动时固定不变 -->
  <svg class="hero-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,60 C180,120 360,0 540,60 C720,120 900,0 1080,60 C1200,100 1350,20 1440,60 L1440,120 L0,120 Z" />
  </svg>

  <!-- 导航栏 — 始终固定在页面最顶部 -->
  <Header />

  <!-- 内容区域 — 整体在背景图下方，滚动时覆盖背景图 -->
  <div class="content-wrapper">

    <!-- 左侧固定个人资料卡片 -->
    {!noSidebar && (
      <aside class="global-sidebar">
        <div class="intro-card">
          <div class="intro-avatar-wrapper">
            <img src="/avatar.jpg" alt="头像" class="intro-avatar" />
          </div>
          <div class="intro-content">
            <h2 class="intro-name">一帧.life</h2>
            <div class="intro-doodle">
              <span class="doodle-text">世界那么大，我先溜达溜达</span>
            </div>
            <ul class="intro-info">
              <li><span class="info-label">生日</span> 6月13日</li>
              <li><span class="info-label">星座</span> 金牛座</li>
              <li><span class="info-label">邮箱</span> 18823549722@163.com</li>
              <li><span class="info-label">爱好</span> 羽毛球</li>
            </ul>
          </div>
        </div>
      </aside>
    )}

    <main class:list={[mainClass, { 'has-sidebar': !noSidebar }]}>
      <slot />
    </main>
    <!-- 右侧分类栏目 -->
    {showCategorySidebar && (
      <slot name="right-sidebar" />
    )}

  </div>

  <!-- 站点运行统计 — 横跨整个页面宽度 -->
  <SiteStats />

  <script>
    // 波浪 SVG 动态定位：跟随 hero 底部，滚动时固定不变
    const wave = document.querySelector('.hero-wave') as SVGElement | null;
    const hero = document.querySelector('.hero-bg') as HTMLElement | null;
    if (wave && hero) {
      const updateWavePosition = () => {
        const heroRect = hero.getBoundingClientRect();
        const heroBottom = heroRect.bottom;
        const waveHeight = 80;
        // hero 还在视口中：波浪贴在 hero 底部
        if (heroBottom > 0) {
          wave.style.top = (heroBottom - waveHeight) + 'px';
          wave.style.display = 'block';
        } else {
          // hero 完全滚出视口：隐藏波浪
          wave.style.display = 'none';
        }
      };
      updateWavePosition();
      window.addEventListener('scroll', updateWavePosition, { passive: true });
      window.addEventListener('resize', updateWavePosition);
    }
  </script>
</body>
</html>

<style>
  body {
    position: relative;
    min-height: 100vh;
    background: transparent;
  }

  /* 顶部背景图区域 — 正常滚动，不固定 */
  .hero-bg {
    width: 100%;
    height: 50vh;
    overflow: hidden;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }

  /* 波浪 SVG — JS 动态设置 top，跟随 hero 底部 */
  .hero-wave {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    z-index: 10;
    pointer-events: none;
    transition: none;
  }

  .hero-wave path {
    fill: #0a0a0f;
  }

  /* 内容区域 — 正常文档流 */
  .content-wrapper {
    position: relative;
    background: transparent;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  main {
    position: relative;
    min-height: calc(100vh - 200px);
    padding: 1.5rem 2rem 3rem;
    flex: 1;
    min-width: 0;
  }

  main.has-sidebar {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* 右侧分类栏 */
  .content-wrapper > .category-sidebar {
    padding-right: 32px;
    padding-left: 0;
  }

  /* ===== 左侧固定个人资料卡片 ===== */
  .global-sidebar {
    position: sticky;
    top: 72px;
    width: 280px;
    flex-shrink: 0;
    align-self: flex-start;
    padding-left: 32px;
    z-index: 50;
    animation: fadeInUp 0.6s ease-out;
  }

  .global-sidebar .intro-card {
    position: relative;
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: visible;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.15s ease;
  }

  .global-sidebar .intro-card:hover {
    border-color: rgba(255, 230, 0, 0.45);
    box-shadow: 0 0 12px rgba(249, 115, 22, 0.15), inset 0 0 8px rgba(249, 115, 22, 0.06);
    transform: translateY(-1px);
  }

  .global-sidebar .intro-avatar-wrapper {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .global-sidebar .intro-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .global-sidebar .intro-content {
    position: relative;
    z-index: 1;
  }

  .global-sidebar .intro-name {
    font-size: 1.4rem;
    font-weight: 900;
    color: #FFE600;
    margin-bottom: 0.3rem;
    letter-spacing: 0.06em;
	    text-shadow: none;
  }

  .global-sidebar .intro-tagline {
    color: var(--text-secondary);
    font-size: 0.82rem;
    margin-bottom: 0.8rem;
    font-weight: 500;
  }

  .global-sidebar .intro-doodle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  .global-sidebar .doodle-text {
	    color: #F97316;
	    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .global-sidebar .intro-info {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    width: 100%;
    text-align: left;
  }

  .global-sidebar .intro-info li {
    color: var(--text-secondary);
    font-size: 0.8rem;
    padding: 0.3rem 0;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .global-sidebar .intro-info li:last-child {
    border-bottom: none;
  }

  .global-sidebar .info-label {
	    color: #F97316;
	    font-weight: 700;
    margin-right: 0.5rem;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1100px) {
    .global-sidebar {
      display: none;
    }
    .content-wrapper > .category-sidebar {
      display: none;
    }
    main.has-sidebar {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .content-wrapper {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    main {
      padding: 1rem 1rem 2rem;
    }
  }
</style>
