---
// 站点瘦骨架（所有页面共用，含首页）：head 样板 + 全站导航行 + 主内容区。
// 各页只负责往 <slot /> 塞内容；全站共享物（GooeyNav 挂载/参数、ClientRouter、
// global.css）只在此处定义一份。
import GooeyNav from '../components/react/GooeyNav';
import { ClientRouter } from 'astro:transitions';
import { navItems, isActiveNav, NAV_PILL_COLOR } from '../lib/nav';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '落羽闲笺 - 世界那么大，我先溜达溜达' } = Astro.props;

// 页面可传完整标题（如首页），否则自动追加站名后缀
const fullTitle = title.includes('落羽闲笺') ? title : `${title} | 落羽闲笺`;

// 导航高亮按当前路径匹配；无匹配项（文章详情/标签页等）传 -1，导航全不亮。
// 严禁兜底到某一项：曾因 Math.max(0, …) 强制归「首页」导致文章页高亮错误、
// 且 GooeyNav 视「首页」为激活项拦截了点击（2026-10-30 修复）
const activeNavIndex = navItems.findIndex((item) => isActiveNav(item.href, Astro.url.pathname));
const gooeyItems = navItems.map(({ href, label }) => ({ href, label }));
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
  <title>{fullTitle}</title>
</head>
<body>
  <div class="page-nav">
    <GooeyNav
      client:load
      items={gooeyItems}
      initialActiveIndex={activeNavIndex}
      theme="light"
      color={NAV_PILL_COLOR}
      size="md"
      frame={true}
      animationTime={280}
      particleCount={30}
      timeVariance={200}
    />
  </div>

  <main>
    <slot />
  </main>
</body>
</html>

<style>
  .page-nav {
    display: flex;
    justify-content: center;
    padding: 1.3rem 1rem 0;
  }
</style>

<!-- 必须全局：scoped 会把 data 属性选择器加到 :where() 外面，反而抬高优先级，
     页面（如首页全屏 landing）就再也覆盖不动 main 了 -->
<style is:global>
  /* :where() 压低优先级，页面可按需覆盖（如首页的全屏 landing） */
  :where(main) {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
</style>
